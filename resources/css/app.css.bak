@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
    /* ============================================================
       DESIGN TOKENS — Light Mode
       ============================================================ */
    :root {
        --bg-primary: 255 255 255;
        --bg-secondary: 248 250 252;
        --surface: 255 255 255;
        --surface-hover: 241 245 249;
        --surface-elevated: 255 255 255;

        --border: 203 213 225;
        --border-soft: 226 232 240;
        --border-strong: 148 163 184;

        --text-primary: 15 23 42;
        --text-secondary: 51 65 85;
        --text-muted: 100 116 139;
        --text-faint: 148 163 184;

        --brand: 5 150 105;
        --brand-hover: 4 120 87;
        --brand-soft: 209 250 229;
        --brand-strong: 6 95 70;

        --accent: 217 119 6;
        --accent-hover: 180 83 9;
        --accent-soft: 254 243 199;

        --success: 5 150 105;
        --success-soft: 209 250 229;
        --warning: 217 119 6;
        --warning-soft: 254 243 199;
        --danger: 220 38 38;
        --danger-soft: 254 226 226;
        --info: 37 99 235;
        --info-soft: 219 234 254;

        --gradient-brand: linear-gradient(135deg, #10b981 0%, #047857 100%);
        --gradient-brand-soft: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
        --gradient-accent: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
        --gradient-danger: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
        --gradient-info: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        --gradient-violet: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
        --gradient-surface: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);

        --shadow-xs: 0 1px 2px rgb(15 23 42 / 0.05);
        --shadow-sm: 0 1px 3px rgb(15 23 42 / 0.08), 0 1px 2px rgb(15 23 42 / 0.04);
        --shadow-md: 0 4px 12px rgb(15 23 42 / 0.08), 0 2px 4px rgb(15 23 42 / 0.05);
        --shadow-lg: 0 12px 32px rgb(15 23 42 / 0.10), 0 4px 12px rgb(15 23 42 / 0.06);
        --shadow-xl: 0 24px 48px rgb(15 23 42 / 0.12), 0 8px 20px rgb(15 23 42 / 0.08);
        --shadow-brand: 0 8px 24px rgb(5 150 105 / 0.30);
        --shadow-accent: 0 8px 24px rgb(217 119 6 / 0.30);

        --radius-sm: 0.5rem;
        --radius-md: 0.75rem;
        --radius-lg: 1rem;
        --radius-xl: 1.25rem;
        --radius-2xl: 1.5rem;
    }

    /* ============================================================
       DESIGN TOKENS — Dark Mode
       ============================================================ */
    [data-theme="dark"] {
        --bg-primary: 2 6 23;
        --bg-secondary: 15 23 42;
        --surface: 30 41 59;
        --surface-hover: 51 65 85;
        --surface-elevated: 30 41 59;

        --border: 51 65 85;
        --border-soft: 30 41 59;
        --border-strong: 71 85 105;

        --text-primary: 248 250 252;
        --text-secondary: 203 213 225;
        --text-muted: 148 163 184;
        --text-faint: 100 116 139;

        --brand: 52 211 153;
        --brand-hover: 110 231 183;
        --brand-soft: 6 78 59;
        --brand-strong: 167 243 208;

        --accent: 251 191 36;
        --accent-hover: 252 211 77;
        --accent-soft: 120 53 15;

        --success: 52 211 153;
        --success-soft: 6 78 59;
        --warning: 251 191 36;
        --warning-soft: 120 53 15;
        --danger: 248 113 113;
        --danger-soft: 127 29 29;
        --info: 96 165 250;
        --info-soft: 30 58 138;

        --gradient-brand: linear-gradient(135deg, #34d399 0%, #059669 100%);
        --gradient-brand-soft: linear-gradient(135deg, #064e3b 0%, #065f46 100%);
        --gradient-accent: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
        --gradient-danger: linear-gradient(135deg, #f87171 0%, #dc2626 100%);
        --gradient-info: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);
        --gradient-violet: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
        --gradient-surface: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);

        --shadow-xs: 0 1px 2px rgb(0 0 0 / 0.4);
        --shadow-sm: 0 1px 3px rgb(0 0 0 / 0.5), 0 1px 2px rgb(0 0 0 / 0.3);
        --shadow-md: 0 4px 12px rgb(0 0 0 / 0.5), 0 2px 4px rgb(0 0 0 / 0.3);
        --shadow-lg: 0 12px 32px rgb(0 0 0 / 0.6), 0 4px 12px rgb(0 0 0 / 0.4);
        --shadow-xl: 0 24px 48px rgb(0 0 0 / 0.7), 0 8px 20px rgb(0 0 0 / 0.5);
        --shadow-brand: 0 8px 24px rgb(52 211 153 / 0.35);
        --shadow-accent: 0 8px 24px rgb(251 191 36 / 0.35);
    }

    html {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        font-feature-settings: 'ss01', 'cv11';
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        scroll-behavior: smooth;
    }

    body {
        background-color: rgb(var(--bg-primary));
        color: rgb(var(--text-primary));
        transition: background-color 0.3s ease, color 0.3s ease;
        min-height: 100vh;
        letter-spacing: -0.011em;
    }

    body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        background:
            radial-gradient(ellipse 70% 60% at 12% -5%, rgb(var(--brand) / 0.10), transparent 60%),
            radial-gradient(ellipse 60% 50% at 88% 8%, rgb(var(--accent) / 0.08), transparent 60%),
            radial-gradient(ellipse 60% 50% at 105% 70%, rgb(var(--brand) / 0.06), transparent 65%),
            radial-gradient(ellipse 55% 45% at -5% 105%, rgb(var(--accent) / 0.05), transparent 60%);
    }

    [data-theme="dark"] body::before {
        background:
            radial-gradient(ellipse 70% 60% at 12% -5%, rgb(var(--brand) / 0.22), transparent 55%),
            radial-gradient(ellipse 60% 50% at 88% 8%, rgb(var(--accent) / 0.14), transparent 55%),
            radial-gradient(ellipse 60% 50% at 105% 70%, rgb(var(--brand) / 0.14), transparent 60%),
            radial-gradient(ellipse 55% 45% at -5% 105%, rgb(var(--accent) / 0.10), transparent 55%);
    }

    body::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0.022;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }

    [data-theme="dark"] body::after { opacity: 0.05; }

    h1, h2, h3, h4, h5, h6 {
        color: rgb(var(--text-primary));
        font-feature-settings: 'ss01', 'cv11';
    }

    /* ← CHANGED: line-height 1.15 → 1.25 (kasih ruang ascender) */
    h1 { font-weight: 800; letter-spacing: -0.05em; line-height: 1.25; }
    h2 { font-weight: 700; letter-spacing: -0.04em; line-height: 1.22; }
    h3 { font-weight: 700; letter-spacing: -0.025em; line-height: 1.30; }
    h4 { font-weight: 600; letter-spacing: -0.015em; }

    p { line-height: 1.65; }

    .tnum, input[type="number"] {
        font-variant-numeric: tabular-nums;
        font-feature-settings: 'tnum';
    }

    ::selection {
        background: rgb(var(--brand) / 0.30);
        color: rgb(var(--text-primary));
    }

    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb {
        background: rgb(var(--text-faint) / 0.4);
        border-radius: 999px;
        border: 3px solid transparent;
        background-clip: content-box;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: rgb(var(--brand) / 0.6);
        background-clip: content-box;
    }
}

@layer components {
    /* SURFACE */
    .surface {
        background: rgb(var(--surface));
        border: 1px solid rgb(var(--border-soft));
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                    box-shadow 0.25s ease,
                    border-color 0.25s ease;
    }
    .surface-hover:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        border-color: rgb(var(--brand) / 0.40);
    }
    .surface-flat {
        background: rgb(var(--surface));
        border: 1px solid rgb(var(--border-soft));
        border-radius: var(--radius-lg);
    }
    .surface-gradient {
        background: var(--gradient-surface);
        border: 1px solid rgb(var(--border-soft));
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
    }

    /* GLASS */
    .glass-card {
        background: rgb(var(--surface) / 0.85);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgb(var(--border-soft));
        border-radius: var(--radius-xl);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.5), var(--shadow-sm);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    [data-theme="dark"] .glass-card {
        background: rgb(var(--surface) / 0.7);
        border-color: rgb(var(--border));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05), var(--shadow-sm);
    }
    .glass {
        background: rgb(var(--surface) / 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgb(var(--border-soft));
        border-radius: var(--radius-md);
    }
    [data-theme="dark"] .glass {
        background: rgb(var(--surface) / 0.5);
        border-color: rgb(var(--border));
    }
    .glass-amber {
        background: rgb(var(--accent) / 0.10);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgb(var(--accent) / 0.30);
        border-radius: var(--radius-md);
        color: rgb(var(--accent));
    }
    [data-theme="dark"] .glass-amber {
        background: rgb(var(--accent) / 0.12);
        border-color: rgb(var(--accent) / 0.35);
    }
    .glass-input {
        background: rgb(var(--surface) / 0.9);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgb(var(--border));
        border-radius: var(--radius-md);
        color: rgb(var(--text-primary));
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    .glass-input:focus-within, .glass-input:focus {
        outline: none;
        border-color: rgb(var(--brand));
        box-shadow: 0 0 0 3px rgb(var(--brand) / 0.18);
    }
    [data-theme="dark"] .glass-input { background: rgb(var(--surface) / 0.6); }

    /* FLOATING NAV */
    .floating-nav {
        position: relative;
        background: rgb(var(--surface) / 0.75);
        backdrop-filter: blur(28px) saturate(180%);
        -webkit-backdrop-filter: blur(28px) saturate(180%);
        border: 1px solid rgb(var(--border-soft));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), inset 0 -1px 0 rgb(255 255 255 / 0.3), var(--shadow-sm);
        overflow: hidden;
    }
    .floating-nav::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        background: linear-gradient(135deg, rgb(255 255 255 / 0.5) 0%, transparent 60%);
        opacity: 0.8;
    }
    .floating-nav::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        background: linear-gradient(135deg, rgb(var(--brand) / 0.14) 0%, rgb(var(--brand) / 0.04) 35%, transparent 70%);
        opacity: 0.9;
    }
    [data-theme="dark"] .floating-nav {
        background: rgb(var(--surface) / 0.65);
        border-color: rgb(var(--border));
    }
    [data-theme="dark"] .floating-nav::before {
        background: linear-gradient(135deg, rgb(255 255 255 / 0.08) 0%, transparent 60%);
    }
    [data-theme="dark"] .floating-nav::after {
        background: linear-gradient(135deg, rgb(var(--brand) / 0.24) 0%, rgb(var(--brand) / 0.08) 35%, transparent 70%);
    }

    /* OVERLAY */
    .glass-overlay {
        background: rgb(var(--surface) / 0.9);
        backdrop-filter: blur(32px) saturate(200%);
        -webkit-backdrop-filter: blur(32px) saturate(200%);
        border: 1px solid rgb(var(--border-soft));
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.8), var(--shadow-lg);
    }
    [data-theme="dark"] .glass-overlay {
        background: rgb(var(--surface) / 0.95);
        border-color: rgb(var(--border));
    }

    /* BUTTONS */
    .btn-primary, .glass-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: var(--gradient-brand);
        color: white;
        font-weight: 600;
        padding: 0.7rem 1.4rem;
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        letter-spacing: -0.01em;
        transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        box-shadow: var(--shadow-brand);
        cursor: pointer;
        border: none;
        text-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
    }
    .btn-primary:hover, .glass-btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 28px rgb(var(--brand) / 0.40);
        filter: brightness(1.05);
    }
    .btn-primary:active, .glass-btn-primary:active {
        transform: translateY(0);
        filter: brightness(0.95);
    }
    .btn-ghost, .glass-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: rgb(var(--surface));
        color: rgb(var(--text-primary));
        font-weight: 500;
        padding: 0.7rem 1.4rem;
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        border: 1px solid rgb(var(--border));
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
        cursor: pointer;
    }
    .btn-ghost:hover, .glass-btn:hover {
        background: rgb(var(--surface-hover));
        border-color: rgb(var(--brand) / 0.50);
        transform: translateY(-1px);
    }
    .glass-btn-amber {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: var(--gradient-accent);
        color: white;
        font-weight: 600;
        padding: 0.7rem 1.4rem;
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        box-shadow: var(--shadow-accent);
        cursor: pointer;
        border: none;
        text-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
    }
    .glass-btn-amber:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 28px rgb(var(--accent) / 0.40);
        filter: brightness(1.05);
    }

    /* FORM FIELD */
    .field {
        background: rgb(var(--surface));
        border: 1px solid rgb(var(--border));
        color: rgb(var(--text-primary));
        border-radius: var(--radius-md);
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        width: 100%;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        font-family: inherit;
    }
    .field::placeholder { color: rgb(var(--text-muted)); }
    .field:focus {
        outline: none;
        border-color: rgb(var(--brand));
        box-shadow: 0 0 0 3px rgb(var(--brand) / 0.20);
    }

    /* PILL */
    .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.3rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: -0.005em;
        background: rgb(var(--brand-soft));
        color: rgb(var(--brand-strong));
        border: 1px solid rgb(var(--brand) / 0.25);
    }
    [data-theme="dark"] .pill {
        background: rgb(var(--brand) / 0.15);
        color: rgb(var(--brand-hover));
        border-color: rgb(var(--brand) / 0.30);
    }
    .pill-accent {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.3rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        background: rgb(var(--accent-soft));
        color: rgb(var(--accent-hover));
        border: 1px solid rgb(var(--accent) / 0.25);
    }
    [data-theme="dark"] .pill-accent {
        background: rgb(var(--accent) / 0.15);
        color: rgb(var(--accent));
        border-color: rgb(var(--accent) / 0.30);
    }

    /* PRICE */
    .price {
        font-variant-numeric: tabular-nums;
        font-feature-settings: 'tnum';
        letter-spacing: -0.025em;
        font-weight: 700;
        color: rgb(var(--brand));
    }
    .text-gradient-green {
        background: var(--gradient-brand);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .text-gradient-accent {
        background: var(--gradient-accent);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* GRADIENT UTILITIES */
    .gradient-brand { background: var(--gradient-brand); }
    .gradient-accent { background: var(--gradient-accent); }
    .gradient-danger { background: var(--gradient-danger); }
    .gradient-info { background: var(--gradient-info); }
    .gradient-violet { background: var(--gradient-violet); }

    /* UTILITIES */
    .text-balance { text-wrap: balance; }
    .text-pretty { text-wrap: pretty; }

    /* ADMIN NAV */
    .admin-nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 1rem;
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        font-weight: 500;
        color: rgb(var(--text-secondary));
        transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
    }
    .admin-nav-item:hover {
        background: rgb(var(--brand) / 0.08);
        color: rgb(var(--brand-hover));
    }
    [data-theme="dark"] .admin-nav-item:hover {
        background: rgb(var(--brand) / 0.12);
        color: rgb(var(--brand));
    }
    .admin-nav-item.is-active {
        background: var(--gradient-brand);
        color: white;
        font-weight: 600;
        box-shadow: var(--shadow-brand);
    }
    .admin-nav-item.is-active:hover { filter: brightness(1.05); color: white; }

    /* FALLBACK */
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .floating-nav { background: rgb(var(--surface)) !important; }
        .glass-overlay { background: rgb(var(--surface)) !important; }
        .glass-card { background: rgb(var(--surface)) !important; }
    }
}

/* ============================================================
   LEVEL C ANIMATIONS
   ============================================================ */

/* ---- MARQUEE ---- */
.marquee-section {
    overflow: hidden;
    padding: 1.75rem 0;
    border-top: 1px solid rgb(var(--border-soft));
    border-bottom: 1px solid rgb(var(--border-soft));
    background: rgb(var(--bg-secondary) / 0.4);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
}
.marquee { overflow: hidden; }
.marquee-track {
    display: flex;
    align-items: center;
    gap: 3rem;
    width: max-content;
    animation: marquee-scroll 32s linear infinite;
    will-change: transform;
}
.marquee-item {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: rgb(var(--text-primary));
    white-space: nowrap;
    opacity: 0.75;
}
.marquee-dot {
    color: rgb(var(--brand));
    font-size: 1.3rem;
    font-weight: 800;
}
@keyframes marquee-scroll { to { transform: translateX(-50%); } }

/* ============================================================
   CARD SPOTLIGHT + HOVER LIFT                          ← ADDED
   Kartu "menonjol" saat hover + gradient hijau ngikut cursor
   ============================================================ */
.product-card,
.limbah-card,
.edukasi-card,
.category-card,
.testimoni-card {
    position: relative;
    isolation: isolate;
    transform-style: preserve-3d;
    will-change: transform;
    /* transition khusus border+shadow (transform dipegang GSAP) */
    transition: box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.35s ease;
}

/* Spot hijau yang ngikutin cursor */
.product-card::before,
.edukasi-card::before,
.category-card::before,
.testimoni-card::before,
.limbah-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s ease;
    z-index: 0;
    background: radial-gradient(
        420px circle at var(--mx, 50%) var(--my, 50%),
        rgb(var(--brand) / 0.16) 0%,
        rgb(var(--brand) / 0.05) 35%,
        transparent 60%
    );
}
/* Limbah: spotlight amber biar match accent-nya */
.limbah-card::before {
    background: radial-gradient(
        420px circle at var(--mx, 50%) var(--my, 50%),
        rgb(var(--accent) / 0.20) 0%,
        rgb(var(--accent) / 0.06) 35%,
        transparent 60%
    );
}
.product-card:hover::before,
.edukasi-card:hover::before,
.category-card:hover::before,
.testimoni-card:hover::before,
.limbah-card:hover::before {
    opacity: 1;
}

/* Pastikan content selalu di atas spotlight */
.product-card > *,
.limbah-card > *,
.edukasi-card > *,
.category-card > *,
.testimoni-card > * {
    position: relative;
    z-index: 1;
}

/* Hover state: border lebih tegas + shadow lebih dalam (transform via GSAP) */
.product-card:hover,
.edukasi-card:hover,
.category-card:hover,
.testimoni-card:hover {
    box-shadow:
        0 30px 60px -18px rgb(var(--brand) / 0.40),
        0 0 0 1px rgb(var(--brand) / 0.55) !important;
    border-color: rgb(var(--brand) / 0.75) !important;
}
.limbah-card:hover {
    box-shadow:
        0 30px 60px -18px rgb(var(--accent) / 0.40),
        0 0 0 1px rgb(var(--accent) / 0.55) !important;
    border-color: rgb(var(--accent) / 0.75) !important;
}

/* ---- MAGNETIC ---- */
.btn-primary,
.btn-ghost,
.glass-btn-amber,
.btn-daftar-gradient {
    will-change: transform;
}

/* ---- REDUCED MOTION ---- */
@media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
    .product-card::before,
    .limbah-card::before,
    .edukasi-card::before,
    .category-card::before,
    .testimoni-card::before { display: none; }
}

/* ============================================================
   ADMIN UTILITY CLASSES — konsisten dengan halaman user
   ============================================================ */
@layer utilities {
    .txt-primary   { color: rgb(var(--text-primary)); }
    .txt-secondary { color: rgb(var(--text-secondary)); }
    .txt-muted     { color: rgb(var(--text-muted)); }
    .txt-faint     { color: rgb(var(--text-faint)); }
    .txt-brand     { color: rgb(var(--brand)); }
    .txt-brand-hover { color: rgb(var(--brand-hover)); }
    .txt-accent    { color: rgb(var(--accent)); }
    .txt-danger    { color: rgb(var(--danger)); }
    .txt-info      { color: rgb(var(--info)); }
    .txt-warning   { color: rgb(var(--warning)); }

    .bg-soft    { background-color: rgb(var(--bg-secondary)); }
    .bg-surface { background-color: rgb(var(--surface)); }
    .bg-card    { background-color: rgb(var(--surface)); }

    .bd-soft    { border-color: rgb(var(--border-soft)); }
    .bd-default { border-color: rgb(var(--border)); }
    .bd-strong  { border-color: rgb(var(--border-strong)); }

    /* Hover text variant (dipanggil dari Blade lewat pattern `hover:txt-*`) */
    [class~="hover:txt-primary"]:hover   { color: rgb(var(--text-primary)); }
    [class~="hover:txt-secondary"]:hover { color: rgb(var(--text-secondary)); }
    [class~="hover:txt-brand"]:hover     { color: rgb(var(--brand)); }
}
/* ============================================================
   ADMIN GLASS CONSISTENCY
   Biar card di admin punya "cahaya" yg sama dgn user side
   ============================================================ */
body.admin-shell .glass-card {
    position: relative;
    overflow: hidden;
    background: rgb(var(--surface) / 0.72);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgb(var(--border-soft));
    box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.5),
        0 12px 32px -12px rgb(0 0 0 / 0.12);
}

[data-theme="dark"] body.admin-shell .glass-card {
    background: rgb(var(--surface) / 0.55);
    border-color: rgb(var(--border));
    box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.05),
        0 12px 32px -12px rgb(0 0 0 / 0.5);
}

/* Glow halus di atas setiap card */
body.admin-shell .glass-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(
        90deg,
        transparent,
        rgb(var(--brand) / 0.6),
        transparent
    );
    pointer-events: none;
}

/* Tabel di dalam glass-card — header auto theme */
body.admin-shell .glass-card table thead tr {
    background: rgb(var(--bg-secondary) / 0.5) !important;
    border-bottom: 1px solid rgb(var(--border-soft));
}
body.admin-shell .glass-card table tbody tr {
    border-bottom: 1px solid rgb(var(--border-soft));
    transition: background 0.15s ease;
}
body.admin-shell .glass-card table tbody tr:hover {
    background: rgb(var(--brand) / 0.05);
}

/* Chip / badge — subtle glow */
body.admin-shell .glass-card span[style*="border-radius"] {
    box-shadow: 0 2px 8px -2px currentColor;
}

/* ============================================================
   ADMIN SHELL OVERHAUL
   ============================================================ */
body.admin-shell::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
        radial-gradient(ellipse 55% 45% at 0% 0%, rgb(var(--brand) / 0.14), transparent 55%),
        radial-gradient(ellipse 50% 40% at 100% 100%, rgb(var(--accent) / 0.10), transparent 55%),
        radial-gradient(ellipse 45% 45% at 100% 0%, rgb(var(--info) / 0.08), transparent 50%);
}
[data-theme="dark"] body.admin-shell::before {
    background:
        radial-gradient(ellipse 55% 45% at 0% 0%, rgb(var(--brand) / 0.24), transparent 55%),
        radial-gradient(ellipse 50% 40% at 100% 100%, rgb(var(--accent) / 0.16), transparent 55%),
        radial-gradient(ellipse 45% 45% at 100% 0%, rgb(var(--info) / 0.12), transparent 50%);
}

body.admin-shell .admin-sidebar {
    background: rgb(var(--surface) / 0.72);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid rgb(var(--border-soft));
    box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.5),
        0 24px 60px -20px rgb(0 0 0 / 0.2),
        0 0 60px -25px rgb(var(--brand) / 0.35);
}
[data-theme="dark"] body.admin-shell .admin-sidebar {
    background: rgb(var(--surface) / 0.58);
    border-color: rgb(var(--border));
    box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.06),
        0 24px 60px -20px rgb(0 0 0 / 0.6),
        0 0 80px -25px rgb(var(--brand) / 0.4);
}

body.admin-shell .admin-topbar {
    background: rgb(var(--surface) / 0.68);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgb(var(--border-soft));
    box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.5),
        0 12px 32px -16px rgb(0 0 0 / 0.15);
}
[data-theme="dark"] body.admin-shell .admin-topbar {
    background: rgb(var(--surface) / 0.55);
    border-color: rgb(var(--border));
    box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.05),
        0 12px 32px -16px rgb(0 0 0 / 0.5);
}

/* Card glass di admin */
body.admin-shell .glass-card {
    position: relative;
    overflow: hidden;
    background: rgb(var(--surface) / 0.72) !important;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgb(var(--border-soft)) !important;
    box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.5),
        0 12px 32px -14px rgb(0 0 0 / 0.12) !important;
}
[data-theme="dark"] body.admin-shell .glass-card {
    background: rgb(var(--surface) / 0.52) !important;
    border-color: rgb(var(--border)) !important;
    box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.05),
        0 12px 32px -14px rgb(0 0 0 / 0.55) !important;
}

/* Glow line atas card */
body.admin-shell .glass-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 8%;
    right: 8%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(var(--brand) / 0.7), transparent);
    pointer-events: none;
}

/* Table di glass-card */
body.admin-shell .glass-card table thead tr {
    background: rgb(var(--bg-secondary) / 0.5) !important;
    border-bottom: 1px solid rgb(var(--border-soft));
}
body.admin-shell .glass-card table tbody tr {
    border-bottom: 1px solid rgb(var(--border-soft));
    transition: background 0.15s ease;
}
body.admin-shell .glass-card table tbody tr:hover {
    background: rgb(var(--brand) / 0.05);
}

/* Neuter gradient chips admin (pesanan/refund stats) */
body.admin-shell .chip-status {
    background: rgb(var(--surface) / 0.6) !important;
    border: 1px solid currentColor;
    color: inherit;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.4);
}

/* Nav item active glow */
body.admin-shell .admin-nav-item.is-active {
    position: relative;
}
body.admin-shell .admin-nav-item.is-active::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(ellipse at center, rgb(var(--brand) / 0.35) 0%, transparent 70%);
    filter: blur(14px);
    pointer-events: none;
    z-index: -1;
}

/* Flatpickr */
body.admin-shell .flatpickr-calendar {
    background: rgb(var(--surface) / 0.95) !important;
    backdrop-filter: blur(20px);
    border: 1px solid rgb(var(--border));
    box-shadow: var(--shadow-lg);
    color: rgb(var(--text-primary));
}
body.admin-shell .flatpickr-day { color: rgb(var(--text-primary)); }
body.admin-shell .flatpickr-day.selected {
    background: rgb(var(--brand)); border-color: rgb(var(--brand)); color: white;
}
